static const size_t entity_table_size = 2125;

std::optional<std::string> lookup_entity(std::string_view name) {
  size_t lo = 0, hi = entity_table_size;
  while (lo < hi) {
    size_t mid = lo + (hi - lo) / 2;
    int cmp = name.compare(entity_table[mid].name);
    if (cmp == 0) {
      std::string result;
      result += encode_utf8(entity_table[mid].codepoints[0]);
      if (entity_table[mid].codepoints[1] != 0) {
        result += encode_utf8(entity_table[mid].codepoints[1]);
      }
      return result;
    } else if (cmp < 0) {
      hi = mid;
    } else {
      lo = mid + 1;
    }
  }
  return std::nullopt;
}
